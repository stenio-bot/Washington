# Nunca coloque credenciais reais neste arquivo. Configure segredos no ambiente hospedado.

# Opções: mcp | marketing_api
META_PROVIDER=mcp

# Necessário quando META_PROVIDER=mcp
META_MCP_ENDPOINT=
META_ACCESS_TOKEN=
META_MCP_LIST_ACCOUNTS_TOOL=
META_MCP_INSIGHTS_TOOL=

# Necessário quando META_PROVIDER=marketing_api
META_GRAPH_API_VERSION=

# Análise por LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
